@article{zakeriMachineLearningPrediction2026,
  title = {Machine {{Learning Prediction}} of {{Vaginal Tissue Tears Using Finite Element Simulations Informed}} by {{Planar Biaxial Testing}}},
  author = {Zakeri, Mostafa and Krometis, Justin and Iliescu, Traian and De Vita, Raffaella},
  date = {2026-03-12},
  year = {2026},
  journaltitle = {Annals of Biomedical Engineering},
  shortjournal = {Ann. Biomed. Eng.},
  issn = {1573-9686},
  doi = {10.1007/s10439-026-04055-3},
  url = {https://doi.org/10.1007/s10439-026-04055-3},
  urldate = {2026-03-13},
  abstract = {Vaginal tissue tearing during childbirth is a prevalent injury with potential long-term consequences, yet the mechanical factors influencing tear behavior remain poorly understood due to the difficulty of conducting in vivo studies. This study aims to investigate how tear geometry and fiber orientation influence local stress and strain patterns, and whether machine learning (ML) can accurately predict tissue responses from finite element (FE) simulation data.},
  langid = {english},
  keywords = {Finite element methods,Machine learning,Vaginal tearing,Vaginal tissue,Women’s health}
}


@article{snyder2025deep,
  abbr={JMBBM},
	title = {Deep learning reduced order models of vaginal tear propagation},
	issn = {1751-6161},
	url = {https://doi.org/10.1016/j.jmbbm.2025.107074},
	html = {https://doi.org/10.1016/j.jmbbm.2025.107074},
	doi = {10.1016/j.jmbbm.2025.107074},
	abstract = {Childbirth often has traumatic consequences that profoundly affect the mother’s health. The passage of a baby through the vagina causes tissue lacerations, such as vaginal tears, which lead to pelvic floor disorders later in life. Despite advances in obstetrics, accurately predicting the possible complications of vaginal delivery remains challenging with current clinical methods. This paper introduces new computational methods that integrate finite element (FE) analysis, proper orthogonal decomposition (POD), and machine learning (ML) to predict vaginal deformations and tearing. Based on ex vivo micro-mechanical data collected from rodents, FE models of the vaginal canal subjected to increasing pressure with propagating tears are created. Snapshots of the FE displacement fields at increasing pressures and with different collagen fiber organization in the proximal, mid, and distal regions of the vagina are then used to develop (a) full-order ML models and (b) POD-based reduced order models with coefficients computed using ML. Both the full-order ML models and POD-ML models with POD bases of dimension l≥2 approximated the FE results with root squared mean errors of O(10−2). Training (offline) times for the ML and POD-ML models were O(102) and O(10) seconds, respectively, whereas prediction (online) times for both ML and POD-ML models were O(10−3) seconds. Thus, the POD-ML models outperformed the ML models in terms of training efficiency while achieving similar prediction accuracy. Our findings demonstrate that the integration of these techniques can lead to faster computations of vaginal delivery outcomes. POD-based reduced order models and ML-based computational tools emerge as non-invasive methods for quantifying vaginal tissue deformations and tears.},
	urldate = {2025-06-06},
	journal = {Journal of the Mechanical Behavior of Biomedical Materials},
	author = {Snyder, William and Zakeri, Mostafa and Krometis, Justin and Batra, Romesh and Iliescu, Traian and De Vita, Raffaella},
	month = jun,
	year = {2025},
	keywords = {Damage, Machine learning, Proper orthogonal decomposition, Tearing, Vaginal tissue},
	pages = {107074},
	file = {ScienceDirect Snapshot:C\:\\Users\\jkrometi\\Zotero\\storage\\A9X2ZLJQ\\S1751616125001900.html:text/html},
}

